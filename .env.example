# Copy to .env and fill in. Never commit .env.

# --- Required -------------------------------------------------------------------------------
# MongoDB Atlas connection string (the server exits if it cannot connect)
MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net/hybrid
# Signing secret for every JWT. In production it MUST be at least 32 random characters, or boot
# fails. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace-with-at-least-32-random-characters
# Google Generative AI key
GEMINI_API_KEY=your-gemini-api-key
# OAuth audience for Google ID tokens; must match the Android client's WEB_CLIENT_ID.
# Required in production.
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# --- Runtime --------------------------------------------------------------------------------
PORT=10000
# Set to "production" on the host: it turns the config warnings above into fatal errors
NODE_ENV=development

# --- Billing --------------------------------------------------------------------------------
BILLING_ENABLED=false
# Must equal the Android applicationId
PLAY_PACKAGE_NAME=com.hybridai.training
# Service account JSON (single line) used to call the Play Developer API
GOOGLE_SERVICE_ACCOUNT_JSON=
# Pub/Sub RTDN push authentication
PUBSUB_VERIFICATION_AUDIENCE=https://your-host.example/api/billing/rtdn
PUBSUB_SERVICE_ACCOUNT_EMAIL=pubsub@your-project.iam.gserviceaccount.com

# --- Freemium limits ------------------------------------------------------------------------
FREE_TRIAL_DAYS=14
FREE_PLAN_LIMIT=1
FREE_CHAT_MESSAGES_PER_DAY=20

# --- Coach context budgets (optional; defaults are in code) ---------------------------------
# CHAT_WINDOW_MAX_TURNS=20
# CHAT_WINDOW_MAX_CHARS=8000
# CHAT_ROUTINE_CONTEXT_MAX_CHARS=2000
# CHAT_HISTORY_PAGE_SIZE=50
