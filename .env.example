# Copy to .env and fill in. Never commit .env.

# --- Core ---
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/hybrid-ai
JWT_SECRET=change-me
PORT=10000
NODE_ENV=development

# --- Google Gemini (the only component that talks to the AI) ---
GEMINI_API_KEY=

# --- Google Sign-In ---
# OAuth audience for verifying Google ID tokens. MUST match the Android client's webClientId.
# If unset, verifyIdToken skips the audience check and would accept a token minted for any
# other Google client — set it.
GOOGLE_WEB_CLIENT_ID=

# --- Google Play Billing ---
# Master switch. While false, POST /api/billing/verify returns 503 rather than granting
# anything. Never fall back to "cannot validate, so grant premium".
BILLING_ENABLED=false

# The app's applicationId, used as {packageName} in the Play Developer API URLs.
PLAY_PACKAGE_NAME=com.hybridai.training

# Base64 of the service account JSON key with the androidpublisher scope, granted
# "View financial data" on the app in Play Console. Link propagation takes 24-48h.
#   base64 -w0 service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Real-time Developer Notifications (Pub/Sub push) ---
# Pub/Sub authenticates by signing a JWT into the Authorization header (it is NOT a signature
# over the body), so the global express.json() is fine and no raw-body capture is needed.
PUBSUB_VERIFICATION_AUDIENCE=https://your-backend.onrender.com/api/billing/rtdn
PUBSUB_SERVICE_ACCOUNT_EMAIL=

# --- Free tier limits ---
FREE_TRIAL_DAYS=14
FREE_PLAN_LIMIT=1
FREE_CHAT_MESSAGES_PER_DAY=2
